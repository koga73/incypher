{
	"name": "incypher",
	"version": "0.9.0",
	"description": "An encrypted keystore intended to store crypto keys, seed phrases, passwords, files and other sensitive data",
	"type": "module",
	"bin": {
		"incypher": "bin/cli.js"
	},
	"scripts": {
		"clean": "rimraf ./build",
		"build": "npm run build:webpack && npm run build:blob && npm run build:exe && npm run build:inject",
		"build:webpack": "webpack",
		"build:blob": "node --experimental-sea-config sea-config.json",
		"build:exe": "node -e \"require('fs').copyFileSync(process.execPath, './build/incypher.exe')\"",
		"build:inject": "postject ./build/incypher.exe NODE_SEA_BLOB ./build/incypher.blob --sentinel-fuse NODE_SEA_FUSE_fce680ab2cc467b6e072b8b5df1996b2",
		"cli": "node ./bin/cli.js"
	},
	"author": {
		"name": "AJ Savino"
	},
	"license": "GPL-3.0",
	"dependencies": {
		"clipboardy": "4.0.0",
		"deluxe-cli": "0.4.1",
		"jszip": "3.10.1"
	},
	"devDependencies": {
		"@angablue/exe": "1.2.0",
		"@babel/core": "^7.24.9",
		"@babel/plugin-syntax-import-assertions": "^7.24.7",
		"@babel/preset-env": "^7.24.8",
		"babel-loader": "^9.1.3",
		"postject": "^1.0.0-alpha.6",
		"rimraf": "^4.0.5",
		"webpack": "^5.93.0",
		"webpack-cli": "^5.1.4"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/koga73/incypher.git"
	},
	"keywords": [
		"crypto",
		"seed",
		"pass",
		"encrypt",
		"decrypt",
		"archive",
		"zip",
		"secure",
		"store",
		"rclone",
		"cloud",
		"sync",
		"portable",
		"interactive"
	],
	"bugs": {
		"url": "https://github.com/koga73/incypher/issues"
	},
	"homepage": "https://github.com/koga73/incypher#readme",
	"engines": {
		"node": ">=20.16.0"
	}
}
